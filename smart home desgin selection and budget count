/* =================================================
   WALL COLOR
================================================= */

function getWallColor(wall){

    if(wall.includes("White"))
        return "#f8f7f2";

    if(wall.includes("Cream"))
        return "#f5e6c8";

    if(wall.includes("Grey"))
        return "#d9dde1";

    if(wall.includes("Green"))
        return "#cbdcc4";

    if(wall.includes("Blue"))
        return "#cbd8e8";

    if(wall.includes("Marble"))
        return "#e8e5df";

    if(wall.includes("Wood"))
        return "#d4b08a";

    if(wall.includes("Yellow"))
        return "#f5df9d";

    return "#e5e5e5";

}


/* =================================================
   ROOM NAME
================================================= */

function getRoomName(room){

    const names = {

        living:"Living Room",
        bedroom:"Bedroom",
        kitchen:"Kitchen",
        bathroom:"Bathroom",
        dining:"Dining Room",
        balcony:"Balcony",
        pooja:"Pooja Room",
        office:"Home Office"

    };

    return names[room];

}


/* =================================================
   STYLE NAME
================================================= */

function getStyleName(style){

    const names = {

        modern:"Modern",
        traditional:"Traditional",
        minimal:"Minimal",
        luxury:"Luxury",
        indian:"Indian Traditional"

    };

    return names[style];

}

