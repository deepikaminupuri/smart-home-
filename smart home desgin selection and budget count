/* =================================================
   FORMAT MONEY
================================================= */

function money(value){

    return "₹" + value.toLocaleString("en-IN");

}


/* =================================================
   GENERATE
================================================= */

function generateDesign(){

    const design = designs[selectedRoom][selectedBudget];

    if(!design){

        alert("Design not available.");

        return;

    }

    document.getElementById("result").style.display="block";

    document.getElementById("resultRoom").textContent =
        getRoomName(selectedRoom);

    document.getElementById("resultStyle").textContent =
        getStyleName(selectedStyle);

    document.getElementById("resultBudget").textContent =
        money(selectedBudget);

    document.getElementById("designLevel").textContent =
        design.level;


    /* ITEMS */

    let total = 0;

    design.items.forEach(item => {

        total += item[2];

    });


    document.getElementById("plannedCost").textContent =
        money(total);


    /* BUDGET BAR */

    let percentage = Math.min(
        (total / selectedBudget) * 100,
        100
    );

    document.getElementById("budgetFill").style.width =
        percentage + "%";


    /* ITEM CARDS */

    let itemHTML = "";

    design.items.forEach(item => {

        itemHTML += `

        <div class="item-card">

            <div class="item-image">
                ${item[1]}
            </div>

            <div class="item-info">

                <h4>${item[0]}</h4>

                <p>
                    Suitable for:
                    ${getRoomName(selectedRoom)}
                </p>

                <p class="price">
                    ${money(item[2])}
                </p>

            </div>

        </div>

        `;

    });


    document.getElementById("itemGrid").innerHTML =
        itemHTML;


    /* BUDGET BREAKDOWN */

    let budgetHTML = "";

    design.items.forEach(item => {

        budgetHTML += `

        <div style="
            display:flex;
            justify-content:space-between;
            padding:12px;
            border-bottom:1px solid #eee;
        ">

            <span>${item[1]} ${item[0]}</span>

            <strong>${money(item[2])}</strong>

        </div>

        `;

    });


    budgetHTML += `

    <div style="
        display:flex;
        justify-content:space-between;
        padding:18px 12px;
        font-size:20px;
    ">

        <strong>Total Design Cost</strong>

        <strong style="color:#6d28d9">
            ${money(total)}
        </strong>

    </div>

    `;


    document.getElementById("budgetItems").innerHTML =
        budgetHTML;


    /* ROOM PREVIEW */

    createRoomPreview(design);


    /* CUSTOMER SUMMARY */

    let customerHTML = "";

    customerHTML += `
        <li>
            <strong>Room:</strong>
            ${getRoomName(selectedRoom)}
        </li>
    `;

    customerHTML += `
        <li>
            <strong>Style:</strong>
            ${getStyleName(selectedStyle)}
        </li>
    `;

    customerHTML += `
        <li>
            <strong>Budget:</strong>
            ${money(selectedBudget)}
        </li>
    `;

    customerHTML += `
        <li>
            <strong>Design Package:</strong>
            ${design.level}
        </li>
    `;

    customerHTML += `
        <li>
            <strong>Wall:</strong>
            ${design.wall}
        </li>
    `;

    customerHTML += `
        <li>
            <strong>Floor:</strong>
            ${design.floor}
        </li>
    `;

    customerHTML += `
        <li>
            <strong>Furniture & Decoration:</strong>
            ${design.items.length} different room-specific items
        </li>
    `;

    customerHTML += `
        <li>
            <strong>Final Planned Cost:</strong>
            ${money(total)}
        </li>
    `;


    document.getElementById("customerList").innerHTML =
        customerHTML;


    document.getElementById("result")
    .scrollIntoView({
        behavior:"smooth"
    });

}


